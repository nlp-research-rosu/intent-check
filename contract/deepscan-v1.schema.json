{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentcomputing.org/contract/deepscan-v1.schema.json",
  "title": "Intent Check DeepScan API, contract v1",
  "description": "POST /v1/deepscans (a gzip'd JSON snapshot of the repo) and GET /v1/deepscans/{job_id}. Shared by the intent plugin and the prover. Changes are additive only. See contract/README.md.",
  "$defs": {
    "Host": { "enum": ["claude-code", "codex"] },
    "Sha1or256": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "RepoPath": {
      "description": "Relative, forward-slash path inside the repo: no leading slash, no drive letter, no backslash, no empty or '..' segments, no NUL.",
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(^|/)\\.\\.(/|$))(?!.*//)(?!.*/$).+$"
    },
    "Criticality": { "enum": ["CRITICAL", "HIGH", "MODERATE", "LOW", "MARGINAL"] },
    "DeepscanStatusValue": { "enum": ["queued", "running", "done", "failed", "superseded"] },

    "DeepscanTrimmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/RepoPath" },
        "reason": { "description": "Why the plugin left the file out (e.g. over_cap, too_large, binary, vendored, generated, secret).", "type": "string", "maxLength": 100 }
      }
    },

    "DeepscanMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "host", "plugin_version", "os", "remote_url", "head_sha", "branch", "dirty", "scope", "file_count", "bytes", "trimmed"],
      "properties": {
        "contract_version": { "const": "1" },
        "host": { "$ref": "#/$defs/Host" },
        "plugin_version": { "type": "string", "maxLength": 40 },
        "os": { "type": "string", "maxLength": 20 },
        "remote_url": {
          "description": "Normalized to https with userinfo stripped, or null when the repo has no remote.",
          "type": ["string", "null"], "maxLength": 500, "pattern": "^https://[^@/\\s]+(/\\S*)?$"
        },
        "head_sha": { "description": "Null for a repo without commits.", "oneOf": [{ "$ref": "#/$defs/Sha1or256" }, { "type": "null" }] },
        "branch": { "type": ["string", "null"], "maxLength": 255 },
        "dirty": { "description": "True when the working tree differs from HEAD.", "type": "boolean" },
        "scope": { "description": "Path prefix the scan was limited to, or null for the whole repo.", "type": ["string", "null"], "maxLength": 1024 },
        "file_count": { "description": "Files in `files`. The server recomputes it.", "type": "integer", "minimum": 0, "maximum": 3000 },
        "bytes": { "description": "UTF-8 bytes of all `content`. The server recomputes it.", "type": "integer", "minimum": 0, "maximum": 15728640 },
        "trimmed": { "description": "Files left out of the snapshot, listed in the report's coverage section.", "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/DeepscanTrimmed" } }
      }
    },

    "DeepscanFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/RepoPath" },
        "content": { "description": "Redacted UTF-8 text, at most 512 KB, no NUL characters. Line numbers are preserved.", "type": "string" }
      }
    },

    "DeepscanUpload": {
      "description": "The document inside the gzip body of POST /v1/deepscans (content-type application/gzip, at most 16 MB compressed and 20 MB inflated). At most 3000 files and 15 MB of text; paths are unique.",
      "type": "object",
      "additionalProperties": false,
      "required": ["meta", "files"],
      "properties": {
        "meta": { "$ref": "#/$defs/DeepscanMeta" },
        "files": { "type": "array", "minItems": 1, "maxItems": 3000, "items": { "$ref": "#/$defs/DeepscanFile" } }
      }
    },

    "DeepscanCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "url", "status", "budget_s"],
      "properties": {
        "job_id": { "type": "string", "pattern": "^[A-Za-z0-9]{22}$" },
        "url": { "type": "string" },
        "status": { "const": "queued" },
        "budget_s": { "description": "Wall-clock seconds the scan is allowed to run, from when it starts. A client waiting for the result waits at most this long, plus the queue time.", "type": "integer", "minimum": 1 }
      }
    },

    "DeepscanProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "hunters_done", "hunters_total", "elapsed_s"],
      "properties": {
        "stage": { "description": "queued, index, map, properties, hunt, gates, report, done.", "type": "string", "maxLength": 40 },
        "hunters_done": { "type": "integer", "minimum": 0 },
        "hunters_total": { "type": "integer", "minimum": 0 },
        "elapsed_s": { "type": "integer", "minimum": 0 }
      }
    },

    "DeepscanCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "$ref": "#/$defs/RepoPath" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },

    "DeepscanCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criticality", "title", "property", "cause", "repro_sketch", "control"],
      "properties": {
        "id": { "type": "string", "maxLength": 40 },
        "criticality": { "$ref": "#/$defs/Criticality" },
        "title": { "type": "string", "maxLength": 200 },
        "property": { "description": "The property the code breaks, in checkable form.", "type": "string", "maxLength": 600 },
        "cause": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/DeepscanCause" } },
        "repro_sketch": { "description": "How the user's agent can reproduce the finding on the user's machine.", "type": "string", "maxLength": 1200 },
        "control": { "description": "A nearby case that should not fail, to rule out a bad repro.", "type": "string", "maxLength": 600 }
      }
    },

    "DeepscanOneLiner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticality", "title", "path", "line"],
      "properties": {
        "criticality": { "$ref": "#/$defs/Criticality" },
        "title": { "type": "string", "maxLength": 200 },
        "path": { "$ref": "#/$defs/RepoPath" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },

    "DeepscanSummary": {
      "description": "Agent-facing result, at most 8 KB serialized.",
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "cards", "one_liners"],
      "properties": {
        "counts": {
          "description": "Findings per criticality (all of them, including ones not listed below).",
          "type": "object",
          "additionalProperties": false,
          "required": ["CRITICAL", "HIGH", "MODERATE", "LOW", "MARGINAL"],
          "properties": {
            "CRITICAL": { "type": "integer", "minimum": 0 },
            "HIGH": { "type": "integer", "minimum": 0 },
            "MODERATE": { "type": "integer", "minimum": 0 },
            "LOW": { "type": "integer", "minimum": 0 },
            "MARGINAL": { "type": "integer", "minimum": 0 }
          }
        },
        "cards": { "description": "The top findings, most critical first.", "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/DeepscanCard" } },
        "one_liners": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/DeepscanOneLiner" } }
      }
    },

    "DeepscanError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "reason": { "type": ["string", "null"] }
      }
    },

    "DeepscanStatus": {
      "description": "GET /v1/deepscans/{job_id}. Owner only (404 for anyone else and for check jobs). `summary` only when done, `error` only when failed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "stage", "progress", "url", "budget_s"],
      "properties": {
        "job_id": { "type": "string", "pattern": "^[A-Za-z0-9]{22}$" },
        "status": { "$ref": "#/$defs/DeepscanStatusValue" },
        "stage": { "type": "string", "maxLength": 40 },
        "progress": { "$ref": "#/$defs/DeepscanProgress" },
        "url": { "type": "string" },
        "budget_s": { "description": "Wall-clock seconds the scan is allowed to run (as on DeepscanCreated).", "type": "integer", "minimum": 1 },
        "summary": { "$ref": "#/$defs/DeepscanSummary" },
        "error": { "$ref": "#/$defs/DeepscanError" }
      }
    }
  }
}
