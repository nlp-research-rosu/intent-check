{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/intent\" session-start --host codex", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/intent\" prompt --host codex", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/intent\" post-tool --host codex", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/intent\" stop --host codex", "timeout": 30 } ] }
    ]
  }
}
